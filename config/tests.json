    {
      "id": "erguss",
      "name": "Erguss (Stroke-Test)",
      "info": {
        "titel": "Stroke-Test (modifiziert)",
        "zeilen": [
          "Rückenlage, Knie gestreckt und locker. 2–3 Mal innen von der Gelenklinie nach oben zum Recessus streichen, dann außen am Oberschenkel nach unten streichen und innen auf eine Flüssigkeitswelle achten.",
          "0 – keine Welle beim Abstreichen",
          "Spur – kleine Welle innen beim Abstreichen",
          "1+ – größere Vorwölbung innen beim Abstreichen",
          "2+ – Flüssigkeit kommt nach dem Hochstreichen von selbst nach innen zurück (ohne Abstreichen)",
          "3+ – Flüssigkeit lässt sich innen nicht wegstreichen"
        ],
        "quelle": "Sturgill et al., JOSPT 2009"
      },
      "block": "klinik",
      "messgeraet": "klinisch",
      "seitenvergleich": false,
      "inEndtestung": true,
      "phasen": ["frueh", "mitte", "spaet", "rtt", "rtc"],
      "kriterien": [
        {
          "id": "grad",
          "bezeichnung": "Stroke-Test",
          "art": "auswahl",
          "optionen": ["0", "Spur", "1+", "2+", "3+"],
          "erlaubt": ["0", "Spur"],
          "werte": {},
          "status": "pflicht",
          "quelle": "Aspetar S. 12; Read S. 59 (keine/minimale Schwellung)"
        }
      ]
